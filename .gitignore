# --- Build artifacts ---
plugin/build/
plugin/.xmake/
ui/missionmenu/build/
ui/missionmenu_lrg/build/
scripts/build/
# patch/ is an intermediate produced by build-saq.ps1 (src + generated embedded quest data)
ui/missionmenu/patch/
ui/missionmenu_lrg/patch/

# --- Third-party dependencies (large; fetch them yourself, see docs/01) ---
tools/commonlibsf-main/
tools/ffdec/
tools/ffdec.zip
tools/vendor/
Interface-main.zip
# Round 98: used to decompile DLC .pex files (Champollion, Orvid fork v1.3.2)
#   Download: https://github.com/Orvid/Champollion/releases -> tools/champollion/Champollion.exe
#   (third-party binaries are never committed; tools/esm/gen_dlc_chain.py prints the URL)
tools/champollion/

# --- Reverse-engineering / analysis intermediates (all regenerable by the tools) ---
# Exception (round 106): ref/extra_quests.json is hand-written source data
#   (the add-on list from the coverage review; the generators cannot rebuild it)
#   => must be committed; the rest of ref/ stays ignored.
#   (pattern ref/* instead of ref/ - otherwise the excluded parent directory blocks re-include)
ref/*
!ref/extra_quests.json

# --- Packaging output (produced by tools/package-saq.ps1; can be rebuilt any time) ---
dist/

# --- Python cache ---
__pycache__/
*.pyc

# --- Misc ---
*.log
*.pdb
*.user
.vs/

# --- Throwaway scripts / temp files (one-shot tools, never commit) ---
.tmp_*
# Round 60: underscore-prefixed one-shot scripts / temp files (commit-message files etc.) - was committed by mistake once
_tmp_*
# Round 147: temp commit-message files for `git commit -F` - committed by mistake again (same class as round 60), hence the prefixed wildcard
_commit_*.tmp
# Throwaway diagnostic scripts (underscore prefix) and temp output (tmp_*.txt) - ignored since round 47
tools/esm/_tmp_*.py
tmp_*.txt
# Temp diagnostic directories (FFDec exports / one-shot check scripts etc.) - ignored since round 50
tmp/
# Round 51: the other spelling of the temp export directory (used by FFDec decompile exports, once seen by git)
.tmp/
