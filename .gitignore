# --- 构建产物 ---
plugin/build/
plugin/.xmake/
ui/missionmenu/build/
ui/missionmenu_lrg/build/
scripts/build/
# patch/ 是 build-saq.ps1 由 src + 生成的内嵌任务数据拼出来的中间产物
ui/missionmenu/patch/
ui/missionmenu_lrg/patch/

# --- 第三方依赖（体积大，按 docs/01 说明自行获取） ---
tools/commonlibsf-main/
tools/ffdec/
tools/ffdec.zip
tools/vendor/
Interface-main.zip
# 第 98 轮：DLC .pex 反编译用（Champollion · Orvid 分支 v1.3.2）
#   下载：https://github.com/Orvid/Champollion/releases → tools/champollion/Champollion.exe
#   （第三方二进制不入库；tools/esm/gen_dlc_chain.py 会提示并给出地址）
tools/champollion/

# --- 逆向 / 分析中间产物（都可由 tools 重新生成） ---
# ★ 第 106 轮例外：ref/extra_quests.json 是**手写源数据**（覆盖面复盘的补收名单，
#   生成器无法重建 —— 见 docs/12）⇒ 必须入库；其余 ref/ 内容照旧不入库。
#   （用 ref/* 而不是 ref/ —— 否则「父目录被排除 ⇒ 无法 re-include」）
ref/*
!ref/extra_quests.json

# --- 打包产物（tools/package-saq.ps1 生成，可随时重打） ---
dist/

# --- Python 缓存 ---
__pycache__/
*.pyc

# --- 其他 ---
*.log
*.pdb
*.user
.vs/

# --- 临时脚本 / 临时文件（一次性工具，勿入库） ---
.tmp_*
# 第 60 轮：下划线前缀的一次性脚本 / 临时文件（提交信息文件等）—— 曾误入库一次
_tmp_*
# 第 147 轮：`git commit -F` 用的提交说明临时文件 —— 又误入库一次（同第 60 轮类别），这次加前缀通配
_commit_*.tmp
# 排查用的一次性脚本（下划线前缀）与临时输出（tmp_*.txt）—— 第 47 轮起明确忽略
tools/esm/_tmp_*.py
tmp_*.txt
# 临时排查目录（FFDec 导出 / 一次性检查脚本等）—— 第 50 轮起忽略
tmp/
# 第 51 轮：临时导出目录的另一种写法（FFDec 反编译导出用过，曾被 git 看到）
.tmp/
