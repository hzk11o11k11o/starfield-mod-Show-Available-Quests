# --- 构建产物 ---
plugin/build/
plugin/.xmake/
ui/missionmenu/build/
ui/missionmenu_lrg/build/
scripts/build/
# patch/ 是 build-saq.ps1 由 src + 生成的内嵌任务数据拼出来的中间产物
ui/missionmenu/patch/
ui/missionmenu_lrg/patch/

# --- 第三方依赖（体积大，按 docs/01 说明自行获取） ---
tools/commonlibsf-main/
tools/ffdec/
tools/ffdec.zip
tools/vendor/
Interface-main.zip

# --- 逆向 / 分析中间产物（都可由 tools 重新生成） ---
ref/

# --- 打包产物（tools/package-saq.ps1 生成，可随时重打） ---
dist/

# --- Python 缓存 ---
__pycache__/
*.pyc

# --- 其他 ---
*.log
*.pdb
*.user
.vs/

# --- 临时脚本 / 临时文件（一次性工具，勿入库） ---
.tmp_*
# 排查用的一次性脚本（下划线前缀）与临时输出（tmp_*.txt）—— 第 47 轮起明确忽略
tools/esm/_tmp_*.py
tmp_*.txt
# 临时排查目录（FFDec 导出 / 一次性检查脚本等）—— 第 50 轮起忽略
tmp/
# 第 51 轮：临时导出目录的另一种写法（FFDec 反编译导出用过，曾被 git 看到）
.tmp/
